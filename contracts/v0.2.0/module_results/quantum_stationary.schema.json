{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quanta:schema:module-result:quantum_stationary:0.1.0",
  "$comment": "Contract only. Run/step outcomes and partial payload eligibility are checked by result.schema.json. Cross-field array dimensions, requested observables, finite numeric values and registry compatibility require semantic validation.",
  "type": "object",
  "properties": {
    "operation": {
      "const": "eigenstates"
    },
    "x_m": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 33
    },
    "energies_j": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 1
    },
    "states": {
      "type": "object",
      "properties": {
        "real": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 33
          },
          "minItems": 1
        },
        "imag": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 33
          },
          "minItems": 1
        }
      },
      "required": [
        "real",
        "imag"
      ],
      "additionalProperties": false
    },
    "grid_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "n_points": {
            "type": "integer",
            "minimum": 31,
            "maximum": 4095
          },
          "energies_j": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 1
          },
          "atol": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rtol": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "n_points",
          "energies_j",
          "atol",
          "rtol"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "pass",
                  "not_converged",
                  "not_checked",
                  "not_applicable"
                ]
              },
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "tolerance": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "status",
              "value",
              "tolerance"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "method",
        "checks"
      ],
      "additionalProperties": false
    },
    "density_per_m": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number",
          "minimum": 0
        },
        "minItems": 33
      },
      "minItems": 1
    },
    "x_mean_m": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 1
    },
    "x2_mean_m2": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      },
      "minItems": 1
    },
    "kinetic_mean_j": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 1
    },
    "potential_mean_j": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 1
    }
  },
  "required": [
    "operation",
    "x_m",
    "energies_j",
    "states",
    "grid_results",
    "diagnostics"
  ],
  "additionalProperties": false
}
