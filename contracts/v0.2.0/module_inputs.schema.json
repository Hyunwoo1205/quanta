{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quanta:schema:module-inputs:0.2.0",
  "title": "Registered first-module input contracts",
  "$comment": "Module versions remain 0.1.0. Definitions here are applied after the generic experiment envelope and registry resolution.",
  "$defs": {
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "const"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "op",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "var"
            },
            "name": {
              "enum": [
                "rho",
                "xi"
              ]
            }
          },
          "required": [
            "op",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "param"
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
            }
          },
          "required": [
            "op",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "add",
                "mul"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 2,
              "maxItems": 8
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "sub",
                "div"
              ]
            },
            "args": {
              "type": "array",
              "prefixItems": [
                {
                  "$ref": "#/$defs/expression"
                },
                {
                  "$ref": "#/$defs/expression"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "neg",
                "exp",
                "log",
                "sqrt",
                "sin",
                "cos"
              ]
            },
            "arg": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "op",
            "arg"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "pow"
            },
            "arg": {
              "$ref": "#/$defs/expression"
            },
            "exponent": {
              "type": "integer",
              "minimum": -12,
              "maximum": 12
            }
          },
          "required": [
            "op",
            "arg",
            "exponent"
          ],
          "additionalProperties": false
        }
      ]
    },
    "potential": {
      "type": "object",
      "properties": {
        "expression": {
          "$ref": "#/$defs/expression"
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
          },
          "additionalProperties": {
            "type": "number"
          },
          "maxProperties": 32
        }
      },
      "required": [
        "expression",
        "parameters"
      ],
      "additionalProperties": false
    },
    "particle": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
        },
        "position_m": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "fixed": {
          "type": "array",
          "prefixItems": [
            {
              "type": "boolean"
            },
            {
              "type": "boolean"
            },
            {
              "type": "boolean"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "id",
        "position_m",
        "fixed"
      ],
      "additionalProperties": false
    },
    "pairSystem": {
      "type": "object",
      "properties": {
        "representation": {
          "const": "particles_3d"
        },
        "module_id": {
          "const": "quanta.pair_static"
        },
        "module_version": {
          "const": "0.1.0"
        },
        "particles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/particle"
          },
          "minItems": 2,
          "maxItems": 128
        },
        "boundary": {
          "const": "nonperiodic"
        },
        "min_distance_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "potential": {
          "$ref": "#/$defs/potential"
        }
      },
      "required": [
        "representation",
        "module_id",
        "module_version",
        "particles",
        "boundary",
        "min_distance_m",
        "potential"
      ],
      "additionalProperties": false
    },
    "quantumSystem": {
      "type": "object",
      "properties": {
        "representation": {
          "const": "quantum_grid_1d"
        },
        "module_id": {
          "const": "quanta.quantum_stationary"
        },
        "module_version": {
          "const": "0.1.0"
        },
        "domain": {
          "type": "object",
          "properties": {
            "a_m": {
              "type": "number"
            },
            "b_m": {
              "type": "number"
            }
          },
          "required": [
            "a_m",
            "b_m"
          ],
          "additionalProperties": false
        },
        "mass_kg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "boundary": {
          "const": "dirichlet_zero"
        },
        "potential": {
          "$ref": "#/$defs/potential"
        }
      },
      "required": [
        "representation",
        "module_id",
        "module_version",
        "domain",
        "mass_kg",
        "boundary",
        "potential"
      ],
      "additionalProperties": false
    },
    "pairNumerics": {
      "type": "object",
      "properties": {
        "solver": {
          "const": "lbfgsb_forward_ad"
        },
        "gradient_tolerance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.001
        },
        "energy_ftol": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.0001
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "max_evaluations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "required": [
        "solver",
        "gradient_tolerance",
        "energy_ftol",
        "max_iterations",
        "max_evaluations"
      ],
      "additionalProperties": false
    },
    "quantumNumerics": {
      "type": "object",
      "properties": {
        "solver": {
          "const": "symmetric_tridiagonal_lowest"
        },
        "n_points": {
          "type": "integer",
          "minimum": 31,
          "maximum": 4095
        },
        "states": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "refinement_levels": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "grid_energy_atol": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "grid_energy_rtol": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "solver",
        "n_points",
        "states",
        "refinement_levels",
        "grid_energy_atol",
        "grid_energy_rtol"
      ],
      "additionalProperties": false
    },
    "override": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "value": {
          "type": [
            "number",
            "boolean"
          ]
        }
      },
      "required": [
        "path",
        "value"
      ],
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "properties": {
        "step_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
        },
        "operation": {
          "enum": [
            "energy_forces",
            "relax",
            "eigenstates"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/override"
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": [
        "step_id",
        "operation",
        "source",
        "overrides"
      ],
      "additionalProperties": false
    },
    "axis": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "maxItems": 16
        }
      },
      "required": [
        "path",
        "values"
      ],
      "additionalProperties": false
    },
    "protocol": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "sweep": {
          "type": "object",
          "properties": {
            "axes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/axis"
              },
              "minItems": 0,
              "maxItems": 2
            }
          },
          "required": [
            "axes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "steps",
        "sweep"
      ],
      "additionalProperties": false
    },
    "pairDefinition": {
      "type": "object",
      "properties": {
        "unit_system": {
          "const": "SI"
        },
        "scales": {
          "type": "object",
          "properties": {
            "length_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "energy_j": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "length_m",
            "energy_j"
          ],
          "additionalProperties": false
        },
        "system": {
          "$ref": "#/$defs/pairSystem"
        },
        "numerics": {
          "$ref": "#/$defs/pairNumerics"
        },
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "observables": {
          "type": "array",
          "items": {
            "enum": [
              "energy",
              "forces",
              "pair_energies",
              "final_positions",
              "optimization_history"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "extensions": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "unit_system",
        "scales",
        "system",
        "numerics",
        "protocol",
        "observables",
        "extensions"
      ],
      "additionalProperties": false
    },
    "quantumDefinition": {
      "type": "object",
      "properties": {
        "unit_system": {
          "const": "SI"
        },
        "scales": {
          "type": "object",
          "properties": {
            "length_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "energy_j": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "length_m",
            "energy_j"
          ],
          "additionalProperties": false
        },
        "system": {
          "$ref": "#/$defs/quantumSystem"
        },
        "numerics": {
          "$ref": "#/$defs/quantumNumerics"
        },
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "observables": {
          "type": "array",
          "items": {
            "enum": [
              "energies",
              "states",
              "density",
              "x_mean",
              "x2_mean",
              "kinetic_mean",
              "potential_mean"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "extensions": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "unit_system",
        "scales",
        "system",
        "numerics",
        "protocol",
        "observables",
        "extensions"
      ],
      "additionalProperties": false
    }
  }
}
