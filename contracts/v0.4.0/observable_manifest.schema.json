{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quanta:schema:observable-manifest:0.4.0",
  "title": "Quanta observable manifest contract",
  "$comment": "Offline contract. Resolve only bundled resources through the fixed allowlist. JSON ingest rejects non-finite numeric values and duplicate keys.",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "0.4.0"
    },
    "observable_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "observable_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "module_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"
    },
    "module_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "meaning": {
      "type": "string",
      "minLength": 1
    },
    "source_ports": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "evaluation_stage": {
      "enum": [
        "post_solve",
        "final_state",
        "iteration_history"
      ]
    },
    "payload_pointer": {
      "type": "string",
      "pattern": "^/"
    },
    "output_schema_ref": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*/)*[A-Za-z0-9_-][A-Za-z0-9_.-]*\\.json(?:#(?:/[A-Za-z0-9_~$.-]+)*)?$"
    },
    "quantity": {
      "type": "object",
      "properties": {
        "value_kind": {
          "enum": [
            "scalar",
            "array",
            "complex_array",
            "table",
            "record"
          ]
        },
        "unit": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "dtype": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "shape": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              }
            ]
          },
          "minItems": 0
        },
        "axis_order": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "complex_encoding": {
          "type": "string",
          "minLength": 1
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "dtype": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "unit",
              "dtype"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "value_kind",
        "unit",
        "dtype",
        "shape",
        "axis_order",
        "complex_encoding",
        "components"
      ],
      "additionalProperties": false
    },
    "computation_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "validation": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "not_executed",
            "verified_for_declared_scope"
          ]
        },
        "case_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "evidence_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "status",
        "case_ids",
        "evidence_artifact_ids"
      ],
      "additionalProperties": false
    },
    "eligible_operations": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "contract_version",
    "observable_id",
    "observable_version",
    "module_id",
    "module_version",
    "description",
    "meaning",
    "source_ports",
    "evaluation_stage",
    "payload_pointer",
    "output_schema_ref",
    "quantity",
    "computation_version",
    "validation",
    "eligible_operations"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "validation": {
            "properties": {
              "status": {
                "const": "verified_for_declared_scope"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "validation"
        ]
      },
      "then": {
        "properties": {
          "validation": {
            "properties": {
              "evidence_artifact_ids": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
