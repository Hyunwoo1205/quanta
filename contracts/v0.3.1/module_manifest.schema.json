{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quanta:schema:dynamics-module-manifest:0.3.1",
  "title": "Standalone velocity-Verlet dynamics declaration",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "0.3.1"
