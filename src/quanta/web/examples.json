{
  "examples": [
    {
      "id": "pair_energy_forces",
      "title": "Single-configuration pair energy and forces",
      "description": "한 배치의 에너지·힘",
      "schema_version": "0.2.0",
      "definition": {
        "unit_system": "SI",
        "scales": {
          "length_m": 1e-09,
          "energy_j": 1e-19
        },
        "system": {
          "representation": "particles_3d",
          "module_id": "quanta.pair_static",
          "module_version": "0.1.0",
          "particles": [
            {
              "id": "p1",
              "position_m": [
                0,
                0,
                0
              ],
              "fixed": [
                true,
                true,
                true
              ]
            },
            {
              "id": "p2",
              "position_m": [
                1.2e-09,
                0,
                0
              ],
              "fixed": [
                false,
                true,
                true
              ]
            }
          ],
          "boundary": "nonperiodic",
          "min_distance_m": 1e-17,
          "potential": {
            "expression": {
              "op": "mul",
              "args": [
                {
                  "op": "const",
                  "value": 0.5
                },
                {
                  "op": "param",
                  "name": "k"
                },
                {
                  "op": "pow",
                  "arg": {
                    "op": "sub",
                    "args": [
                      {
                        "op": "var",
                        "name": "rho"
                      },
                      {
                        "op": "param",
                        "name": "rho0"
                      }
                    ]
                  },
                  "exponent": 2
                }
              ]
            },
            "parameters": {
              "k": 2,
              "rho0": 1
            }
          }
        },
        "numerics": {
          "solver": "lbfgsb_forward_ad",
          "gradient_tolerance": 1e-06,
          "energy_ftol": 1e-12,
          "max_iterations": 2000,
          "max_evaluations": 10000
        },
        "protocol": {
          "steps": [
            {
              "step_id": "evaluate",
              "operation": "energy_forces",
              "source": "initial",
              "overrides": []
            }
          ],
          "sweep": {
            "axes": []
          }
        },
        "observables": [
          "energy",
          "forces",
          "pair_energies",
          "final_positions"
        ],
        "extensions": {}
      }
    },
