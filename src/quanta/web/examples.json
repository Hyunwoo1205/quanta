    {
      "id": "quantum_eigenstates",
      "title": "Finite-interval stationary energy states",
      "description": "유한 1차원 양자 정적 상태",
      "schema_version": "0.2.0",
      "definition": {
        "unit_system": "SI",
        "scales": {
          "length_m": 1e-09,
          "energy_j": 1e-20
        },
        "system": {
          "representation": "quantum_grid_1d",
          "module_id": "quanta.quantum_stationary",
          "module_version": "0.1.0",
          "domain": {
            "a_m": 0,
            "b_m": 1e-09
          },
          "mass_kg": 1e-30,
          "boundary": "dirichlet_zero",
          "potential": {
            "expression": {
              "op": "const",
              "value": 0
            },
            "parameters": {}
          }
        },
        "numerics": {
          "solver": "symmetric_tridiagonal_lowest",
          "n_points": 255,
          "states": 4,
          "refinement_levels": 2,
          "grid_energy_atol": 1e-08,
          "grid_energy_rtol": 0.001
        },
        "protocol": {
          "steps": [
            {
              "step_id": "spectrum",
              "operation": "eigenstates",
              "source": "initial",
              "overrides": []
            }
          ],
          "sweep": {
            "axes": []
          }
        },
        "observables": [
          "energies",
          "states",
          "density",
          "x_mean",
          "x2_mean",
          "kinetic_mean",
          "potential_mean"
        ],
        "extensions": {}
      }
    },
