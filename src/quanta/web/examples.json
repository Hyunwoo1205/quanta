                true
              ]
            },
            {
              "id": "p2",
              "position_m": [
                1.2e-09,
                0,
                0
              ],
              "fixed": [
                false,
                true,
                true
              ]
            }
          ],
          "boundary": "nonperiodic",
          "min_distance_m": 1e-17,
          "potential": {
            "expression": {
              "op": "mul",
              "args": [
                {
                  "op": "const",
                  "value": 0.5
                },
                {
                  "op": "param",
                  "name": "k"
                },
                {
                  "op": "pow",
                  "arg": {
                    "op": "sub",
                    "args": [
                      {
                        "op": "var",
                        "name": "rho"
                      },
                      {
                        "op": "param",
                        "name": "rho0"
                      }
                    ]
                  },
                  "exponent": 2
                }
              ]
            },
            "parameters": {
              "k": 2,
              "rho0": 1
            }
          }
        },
        "numerics": {
          "solver": "lbfgsb_forward_ad",
          "gradient_tolerance": 1e-06,
          "energy_ftol": 1e-12,
          "max_iterations": 2000,
          "max_evaluations": 10000
        },
        "protocol": {
          "steps": [
            {
              "step_id": "baseline",
              "operation": "energy_forces",
              "source": "initial",
              "overrides": []
            },
            {
              "step_id": "relax",
              "operation": "relax",
              "source": "baseline",
              "overrides": []
            },
            {
              "step_id": "final",
              "operation": "energy_forces",
              "source": "relax",
              "overrides": []
            }
          ],
          "sweep": {
            "axes": [
              {
                "path": "/system/potential/parameters/k",
                "values": [
                  2,
                  4
                ]
              }
            ]
          }
        },
        "observables": [
          "energy",
          "forces",
          "pair_energies",
          "final_positions",
          "optimization_history"
        ],
        "extensions": {}
      }
