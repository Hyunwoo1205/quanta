    {
      "id": "pair_workflow",
      "title": "Parameter sweep with a constrained relaxation workflow",
      "description": "조건별 반복과 결과 전달",
      "schema_version": "0.2.0",
      "definition": {
        "unit_system": "SI",
        "scales": {
