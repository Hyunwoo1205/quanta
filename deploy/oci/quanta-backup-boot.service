[Unit]
Description=Quanta consistent SQLite snapshot on explicit boot-volume storage
Requires=docker.service
After=docker.service local-fs.target quanta-backup.service
Conflicts=quanta-backup.service
RequiresMountsFor=/srv/quanta
AssertPathIsDirectory=/srv/quanta

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/quanta/runtime.py backup --storage-mode boot
ExecStop=-/usr/bin/docker stop --time 20 quanta-backup
TimeoutStartSec=180
TimeoutStopSec=40
KillMode=control-group
