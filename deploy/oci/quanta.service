[Unit]
Description=Quanta private research workspace
Requires=docker.service
After=docker.service srv-quanta.mount
BindsTo=srv-quanta.mount
PartOf=docker.service
RequiresMountsFor=/srv/quanta
AssertPathIsMountPoint=/srv/quanta
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
UMask=0077
ExecStartPre=/usr/bin/python3 /usr/local/lib/quanta/runtime.py check
ExecStart=/usr/bin/python3 /usr/local/lib/quanta/runtime.py run
ExecStop=-/usr/bin/docker stop --time 40 quanta
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillMode=control-group

[Install]
WantedBy=multi-user.target
