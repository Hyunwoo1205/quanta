[Unit]
Description=Quanta private research workspace on explicit boot-volume storage
Requires=docker.service
After=docker.service local-fs.target quanta.service
PartOf=docker.service
Conflicts=quanta.service
RequiresMountsFor=/srv/quanta
AssertPathIsDirectory=/srv/quanta
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
UMask=0077
ExecStartPre=/usr/bin/python3 /usr/local/lib/quanta/runtime.py check --storage-mode boot
ExecStart=/usr/bin/python3 /usr/local/lib/quanta/runtime.py run --storage-mode boot
ExecStop=-/usr/bin/docker stop --time 40 quanta
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillMode=control-group

[Install]
WantedBy=multi-user.target
