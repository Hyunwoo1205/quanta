# Official linux/arm64/v8 child manifest and config verified from Docker Hub on 2026-11-04 (UTC+09:00).
# The config declares architecture=arm64, os=linux and PYTHON_VERSION=3.12.14.
FROM --platform=linux/arm64 python:3.12.14-slim-bookworm@sha256:eb5be8e5b4d0a159c237946bbdd06356dda5d19c30fc4f7843e8046d3a590333

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1

WORKDIR /app
COPY requirements.aarch64.lock.txt ./requirements.aarch64.lock.txt
RUN python -m pip install --only-binary=:all: --require-hashes -r requirements.aarch64.lock.txt
COPY . .
RUN python -m pip install --no-deps --no-build-isolation .
CMD ["python", "-m", "quanta", "check-contracts"]
